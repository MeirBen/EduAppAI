{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Async", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal"
      }
    },
    "Enrich": ["FromLogContext"],
    "Properties": { "Application": "FamilyLearning.Api" },
    "WriteTo": {
      "Console": {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      "File": {
        "Name": "Async",
        "Args": {
          "bufferSize": 10000,
          "blockWhenFull": false,
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "logs/server-.jsonl",
                "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact",
                "rollingInterval": "Day",
                "fileSizeLimitBytes": 20971520,
                "rollOnFileSizeLimit": true,
                "retainedFileCountLimit": 14,
                "shared": true
              }
            }
          ]
        }
      }
    }
  },
  "AllowedHosts": "*",
  "Ai": {
    "Model": "openai/gpt-6.1-sol",
    "FallbackModel": "",
    "IgnoredProviders": [],
    "MaxPrice": {
      "PromptPerMillion": 2,
      "CompletionPerMillion": 10
    },
    "ResponseFormat": "json_schema",
    "SchemaInPrompt": false,
    "StrictQuestionCountLimit": 20,
    "MaxOutputTokens": 16384,
    "MaxRequestBytes": 524288,
    "MaxSchemaBytes": 65536,
    "ReasoningEnabled": true,
    "ReasoningEffort": "medium",
    "ReasoningMaxTokens": null,
    "Temperature": null,
    "TopP": null,
    "TopK": null,
    "Endpoint": "https://openrouter.ai/api/v1"
  }
}
