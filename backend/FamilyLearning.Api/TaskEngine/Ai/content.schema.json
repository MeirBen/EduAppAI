{
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Main heading of this generated task, consistent with its actual content. Put the task heading here instead of repeating it in contentBlocks.",
      "minLength": 1,
      "maxLength": 100
    },
    "instructions": {
      "description": "Directions for the learner completing this task, in the requested language; not generation steps, parameter keys or answer-key details.",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000
    },
    "contentBlocks": {
      "type": "array",
      "description": "Learning material presented before the questions; an empty array when no passage is needed.",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text"
            ]
          },
          "text": {
            "type": "string",
            "description": "Passage body in the requested language, without repeating the task title. Use newline characters for requested paragraph breaks. Preserve source text exactly, including any headings, when verbatim reproduction is requested.",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "type",
          "text"
        ],
        "additionalProperties": false
      },
      "maxItems": 4
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "prompt": {
            "type": "string",
            "description": "One question or exercise for the learner, without an added question number.",
            "minLength": 1,
            "maxLength": 500
          },
          "interaction": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "numeric-input",
                  "text-input",
                  "single-choice"
                ]
              },
              "options": {
                "description": "Distinct, trimmed, single-line answer texts for single-choice questions, without decorative labels; null for other interaction types.",
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "minItems": 2,
                "maxItems": 6
              }
            },
            "required": [
              "type",
              "options"
            ],
            "additionalProperties": false
          },
          "answer": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "description": "Parent-only correct answer. For single-choice, copy the correct option exactly; for numeric-input, use invariant decimal text.",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "value"
            ],
            "additionalProperties": false
          },
          "points": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "id",
          "prompt",
          "interaction",
          "answer",
          "points"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 20
    }
  },
  "required": [
    "title",
    "instructions",
    "contentBlocks",
    "questions"
  ],
  "additionalProperties": false
}
