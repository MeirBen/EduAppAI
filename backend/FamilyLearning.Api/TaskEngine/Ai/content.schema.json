{
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "instructions": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000
    },
    "contentBlocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "type",
          "text"
        ],
        "additionalProperties": false
      },
      "maxItems": 4
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "interaction": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "numeric-input",
                  "text-input",
                  "single-choice"
                ]
              },
              "options": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "minItems": 2,
                "maxItems": 6
              }
            },
            "required": [
              "type",
              "options"
            ],
            "additionalProperties": false
          },
          "answer": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "value"
            ],
            "additionalProperties": false
          },
          "points": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "id",
          "prompt",
          "interaction",
          "answer",
          "points"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 20
    }
  },
  "required": [
    "title",
    "instructions",
    "contentBlocks",
    "questions"
  ],
  "additionalProperties": false
}
